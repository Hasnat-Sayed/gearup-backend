model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String
  phone        String?
  role         Role         @default(CUSTOMER)
  activeStatus ActiveStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  gearItems    GearItem[]     // as Provider
  rentalOrders RentalOrder[]  // as Customer
  reviews      Review[]

  @@map("users")
}